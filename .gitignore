# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# Gradle wrapper 必须进版本库，否则干净 clone 没有 gradlew
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ── 构建产物与本地依赖（体积极大，且可从 POM / 官方源重新获取）──────────
.gradle/
build/
build*.log

#   libs/ 只是可选的本地覆盖入口；正常构建由 ForgeGradle 从 Maven 解析依赖。
libs/

# IDE
.idea/
*.iml
.vscode/

# 本地配置（可能含签名口令）
local.properties

# test-builds 分支：测试包产物需要进版本库供下载
!test-builds/**
